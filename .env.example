POSTGRES_DB=weather_db
POSTGRES_USER=user_d
POSTGRES_PASSWORD=changeme

OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Docker Compose project name — controls container prefix and network name.
# Network will be: <COMPOSE_PROJECT_NAME>_my-network
COMPOSE_PROJECT_NAME=weather-data-engineer

# Project root path — used by Airflow DockerOperator to mount host volumes.
# Default "." means current working directory. Change only if your
# docker-compose project root differs from the working directory.
HOST_PROJECT_PATH=.

# Docker network name — must match <COMPOSE_PROJECT_NAME>_my-network.
DOCKER_NETWORK=weather-data-engineer_my-network
