# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF (Docker runs on Linux)
*.sh text eol=lf
*.bash text eol=lf

# Config files that Docker/Linux reads
*.yml text eol=lf
*.yaml text eol=lf

# Dockerfile
Dockerfile* text eol=lf

# SQL init scripts
*.sql text eol=lf

# Python
*.py text eol=lf

# Makefiles (if any)
Makefile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
